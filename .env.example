# Copy to .env (or export) — nothing here is required; every value has a default.
CLASSIFIER=fake              # fake | anthropic
ANTHROPIC_API_KEY=           # only for CLASSIFIER=anthropic; never commit a real key
LLM_MODEL=claude-opus-5
DB_PATH=tickets.db
WORKER_CONCURRENCY=3
MAX_ATTEMPTS=3
RETRY_BASE_DELAY=1.0
LLM_TIMEOUT=30
LEASE_SECONDS=60
FAKE_FAILURE_RATE=0.15
FAKE_SEED=42
PRICE_INPUT_PER_MTOK=5.0     # only used for the reclassify-stale cost estimate
PRICE_OUTPUT_PER_MTOK=25.0
INGEST_RATE_PER_MINUTE=60    # per client IP on POST endpoints; 0 disables
DAILY_MODEL_CALL_LIMIT=0     # hard cap on model calls per UTC day; 0 = unlimited. Workers pause when reached.
ADMIN_TOKEN=                 # if set, /stats and the reclassify endpoints need "Authorization: Bearer <token>"
